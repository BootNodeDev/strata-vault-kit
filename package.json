{
  "name": "strata-vault-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "prestart": "node scripts/dev-guard.mjs",
    "start": "npm start --workspace app",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run"
  },
  "workspaces": [
    "app",
    "app-lib",
    "app-lib/clients/*",
    "e2e"
  ],
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "jsdom": "29.1.1",
    "prettier": "^3.8.3",
    "vitest": "4.1.11"
  },
  "prettier": "@theahaco/ts-config/prettier",
  "packageManager": "npm@11.7.0"
}
