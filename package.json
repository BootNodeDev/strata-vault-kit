{
  "name": "open-rwa-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "prestart": "node scripts/dev-guard.mjs",
    "start": "npm start --workspace app",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "workspaces": [
    "app",
    "app-lib",
    "app-lib/clients/*",
    "e2e"
  ],
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "prettier": "@theahaco/ts-config/prettier",
  "packageManager": "npm@11.7.0"
}
