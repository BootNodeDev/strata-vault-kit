{
  "name": "@strata-vault-kit/app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "prestart": "node ../scripts/generate-addresses.mjs",
    "start": "concurrently --kill-others-on-fail --names stellar,vite -c gray,green --pad-prefix \"stellar scaffold watch --build-clients\" \"vite\"",
    "prebuild": "node ../scripts/generate-addresses.mjs && node ../scripts/generate-clients.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@stellar-scaffold/app-lib": "*",
    "@tanstack/react-query": "^5.90.17",
    "@theahaco/ts-config": "^1.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "buffer": "6.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^10.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "engines": {
    "stellar-scaffold": ">=0.0.24"
  }
}
